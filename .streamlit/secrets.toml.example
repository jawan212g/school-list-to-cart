# Copy this file to secrets.toml and add your real key. This default keeps
# the existing OpenAI Responses API behavior.
OPENAI_API_KEY = "sk-replace-me"

# To use IU's Kelley GPT API instead, remove or ignore OPENAI_API_KEY and
# configure the four settings below. Leave LLM_VISION_MODEL unset when the
# selected provider has no verified vision-capable model; image uploads will
# then be rejected before extraction.
#
# LLM_BASE_URL = "https://hub.kelley.iu.edu/llmapi/v1"
# LLM_API_KEY = "replace-with-kelley-key"
# LLM_TEXT_MODEL = "gpt-oss-20b"
# LLM_VISION_MODEL = "gemma-4-31B-it"
#
# secrets.toml is gitignored and must never be committed.
